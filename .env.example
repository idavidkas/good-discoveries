# Server polls Crossref every 15 minutes (900 seconds).
POLL_INTERVAL_SECONDS=900
ENABLE_POLLER=true

# An empty key means no AI classification: candidates await manual review.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# CAUTION: automatic publishing uses model judgment, not independent replication.
# Disabled by default. Enable only after testing and setting an API key.
AUTO_PUBLISH=false
MAX_AI_REVIEWS_PER_CYCLE=6

# Protect the editorial API and /admin actions with a secret token.
ADMIN_TOKEN=replace-with-very-long-random-secret
CROSSREF_MAILTO=
DATABASE_PATH=./data/news.db

# Public GitLab Pages origin only (no path), e.g. https://example.gitlab.io
FRONTEND_ORIGINS=https://example.gitlab.io
# Generate with: python scripts/generate_vapid.py
# Mount this secret file outside the public frontend. NEVER commit it.
VAPID_PRIVATE_KEY_FILE=/app/secrets/vapid_private.pem
VAPID_SUBJECT=mailto:you@example.com

# For compose.prod.yaml (VPS + automatic HTTPS):
API_HOST=api.example.com
